{
  "name": "gpl",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "GPL — a short, single-player learning game about how a client engagement really works.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/prepare-runtime.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node tools/verify-game.mjs --matrix",
    "filecheck": "node tools/file-url-check.mjs",
    "lmscheck": "node tools/lms-check.mjs",
    "scorm": "npm run build && node tools/file-url-check.mjs && node tools/lms-check.mjs && node tools/scorm-package.mjs",
    "validate": "tsc --noEmit && vitest run && node tools/comprehension.mjs --strict && vite build && node tools/prepare-runtime.mjs",
    "comprehension": "node tools/comprehension.mjs --strict"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
